{
  "name": "propeptiq-labs-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:postgres:checkout": "vitest run --config vitest.postgres.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "test:e2e": "node scripts/run-playwright-e2e.mjs",
    "verify:workspace-boundary": "node scripts/verify-workspace-boundary.mjs",
    "verify:production-artifacts": "node scripts/verify-production-artifacts.mjs",
    "test:artifact-scanner": "node --test scripts/verify-production-artifacts.test.mjs",
    "audit:prod": "npm audit --omit=dev",
    "verify": "run-s verify:workspace-boundary lint typecheck test build"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@opentelemetry/api": "1.9.1",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@vercel/blob": "2.8.0",
    "@vercel/otel": "2.1.3",
    "better-auth": "1.6.23",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.34.0",
    "next": "16.3.2",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.22.1",
    "server-only": "0.0.1",
    "shadcn": "^4.19.0",
    "stripe": "22.5.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.7",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "fast-check": "4.9.0",
    "jsdom": "30.0.1",
    "npm-run-all2": "9.0.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "drizzle-kit@0.31.10": {
      "@esbuild-kit/esm-loader": {
        "@esbuild-kit/core-utils": {
          "esbuild": "0.25.12"
        }
      }
    }
  }
}

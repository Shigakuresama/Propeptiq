# Environment identity. Keep local unless a separately configured deployment says otherwise.
APP_ENV=local
APP_ORIGIN=
# Synthetic fixtures are local/test-only and fail closed for production identities.
CATALOG_DEMO_MODE=disabled
# Non-secret exact-match authorization for the owner-supplied browse-only manifest.
# Production remains empty when this is blank. See docs/compliance/catalog-policy.md.
# Current approved value: owner-pdf-2026-08-27-07cd4aa0-v1
BROWSE_CATALOG_PUBLICATION=
LOCAL_TEST_DRIVER=disabled
LOCAL_TEST_SECRET=
RATE_LIMIT_SECRET=

# Adapter modes default closed. Valid values: disabled, test, live.
AUTH_MODE=disabled
DATABASE_MODE=disabled
PAYMENTS_MODE=disabled
STORAGE_MODE=disabled
EMAIL_MODE=disabled
TAX_MODE=disabled
SHIPPING_MODE=disabled
FULFILLMENT_MODE=disabled

# Live creation capability attestations are separate from adapter selection.
# These values do not claim provider, catalog, quote, or operational approval.
# Signed provider events can still be drained while both creation capabilities are closed.
COMMERCE_LIVE_CAPABILITY=disabled
PAYMENTS_LIVE_CAPABILITY=disabled

# Clerk (server secret must never use NEXT_PUBLIC_).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Neon PostgreSQL. Runtime and migration-owner URLs should use separate roles.
# Pooled runtime connection. Read by src/db/runtime.ts when DATABASE_MODE=live.
DATABASE_URL=
# RESERVED AND NOT YET CONSUMED. No code path reads this today: drizzle.config.ts
# declares no dbCredentials and there is no db:migrate script, because
# src/db/migrations/README.md deliberately withholds a live migration command.
# Setting it has no effect. Applying a migration to a real database remains a
# separately authorized, reviewed operator process -- see
# docs/runbooks/production-cutover.md.
DATABASE_MIGRATION_URL=
TEST_DATABASE_URL=
# Required verbatim with DATABASE_MODE=test after confirming isolation.
TEST_DATABASE_CONFIRMATION=

# Stripe-hosted Checkout. Live adapter selection requires a live database and credentials.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Nonsecret account namespace fence, required for Stripe test/live modes.
STRIPE_ACCOUNT_ID=

# Stripe ShippingRate (shr_...) backing the shipping quote port. Exactly one
# owner-configured rate; the adapter never lists rates and chooses between them,
# so the same cart always quotes the same amount.
STRIPE_SHIPPING_RATE_ID=
# Stripe Tax product tax code (txcd_...). Use txcd_99999999, General - Tangible
# Goods: research-use physical goods have no more specific code, and food,
# supplement or medicine codes carry reduced rates that would be wrong here.
STRIPE_TAX_CODE=
# Both are optional in the schema on purpose and are NOT enforced by
# requireFields. Demanding them whenever TAX_MODE/SHIPPING_MODE is enabled would
# break the synthetic local harness, which runs both at "test" with no Stripe
# configuration at all. The PostgreSQL buyer runtime instead refuses to compose
# without them -- see isPostgresBuyerCheckoutReady in src/commerce/server-runtime.ts.

# Private Vercel Blob and Resend transactional email.
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
RESEND_FROM=

# Optional telemetry configuration.
OTEL_SERVICE_NAME=propeptiq-labs
